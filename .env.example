# Urban Air Quality Assistant - Environment Variables

# Google Gemini API Key for Generative AI recommendations
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model Name (default: gemini-1.5-flash)
# You can set any model here, e.g. gemini-1.5-flash, gemini-2.0-flash, gemini-2.5-flash, etc.
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAQ API Key (not required for basic usage)
# OPENAQ_API_KEY=your_openaq_api_key_here

# Optional: Default city and country for initial load
# DEFAULT_CITY=Delhi
# DEFAULT_COUNTRY=IN
